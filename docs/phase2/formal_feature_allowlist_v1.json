      "planned_status": "allow_after_provenance_gate",
      "allowed_for_collection_after_provenance_gate": true
    },
    {
      "feature_name": "repeated_action_count",
      "definition": "Count of calls whose canonical public tool name and normalized public arguments exactly match an earlier completed call.",
      "mathematical_definition": "sum_i I(signature_i in {signature_j: j < i}), where signature excludes IDs/timestamps/internal metadata",
      "source": "canonical_agent_messages.tool_calls",
      "raw_data_source": "agent/messages.json",
      "computation_code_location": "src/risk_agent/collection/formal_features.py:extract_decision_features",
