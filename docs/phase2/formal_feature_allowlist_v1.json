      "planned_status": "allow_after_provenance_gate",
      "allowed_for_collection_after_provenance_gate": true
    },
    {
      "feature_name": "remaining_step_budget",
      "definition": "Number of model action steps still allowed after the captured ActionStep.",
      "mathematical_definition": "max(0, max_steps - step_index)",
      "source": "agent_runtime.max_steps_and_completed_step",
      "raw_data_source": "agent/runtime.json",
      "computation_code_location": "src/risk_agent/collection/formal_features.py:extract_decision_features",
      "available_at_decision_time": true,
