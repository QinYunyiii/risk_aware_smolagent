  "scope": "decision-time formal collection only; not model deployment",
  "features": [
    {
      "feature_name": "step_index",
      "definition": "The completed ActionStep number at the decision checkpoint.",
      "mathematical_definition": "step_index = integer(ActionStep.step_number)",
      "source": "canonical_agent_memory.latest_action_step.step_number",
      "raw_data_source": "agent/memory_steps.json and agent/latest_action_step.json",
      "computation_code_location": "src/risk_agent/collection/formal_features.py:extract_decision_features",
      "available_at_decision_time": true,
      "enters_agent_memory": true,
      "visible_to_agent": false,
      "actually_received_by_agent": false,
      "depends_on_internal_metadata": false,
      "computed_from_future_data": false,
      "allowed_for_deployment": false,
      "review_status": "conditional_on_current_local_acceptance_receipt",
      "planned_status": "allow_after_provenance_gate",
      "allowed_for_collection_after_provenance_gate": true
    },
    {
      "feature_name": "tool_call_count",
      "definition": "Number of completed tool calls represented in canonical Agent messages through the checkpoint.",
      "mathematical_definition": "sum over completed Assistant tool-call records before or at t",
      "source": "canonical_agent_messages.tool_calls",
      "raw_data_source": "agent/messages.json",
      "computation_code_location": "src/risk_agent/collection/formal_features.py:extract_decision_features",
      "available_at_decision_time": true,
      "enters_agent_memory": true,
      "visible_to_agent": true,
      "actually_received_by_agent": true,
      "depends_on_internal_metadata": false,
      "computed_from_future_data": false,
      "allowed_for_deployment": false,
      "review_status": "conditional_on_current_local_acceptance_receipt",
      "planned_status": "allow_after_provenance_gate",
      "allowed_for_collection_after_provenance_gate": true
    },
    {
      "feature_name": "observed_history_count",
      "definition": "Number of completed Tool Response messages received by the Agent through the checkpoint.",
      "mathematical_definition": "count(message.role == tool-response, messages <= t)",
      "source": "canonical_agent_messages.tool_responses",
      "raw_data_source": "agent/messages.json",
      "computation_code_location": "src/risk_agent/collection/formal_features.py:extract_decision_features",
      "available_at_decision_time": true,
      "enters_agent_memory": true,
