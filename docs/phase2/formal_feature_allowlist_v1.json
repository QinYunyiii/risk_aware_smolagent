      "planned_status": "allow_after_provenance_gate",
      "allowed_for_collection_after_provenance_gate": true
    },
    {
      "feature_name": "repeated_action_ratio",
      "definition": "Fraction of completed calls that repeat an earlier canonical action; zero when no calls exist.",
      "mathematical_definition": "repeated_action_count / tool_call_count if tool_call_count > 0 else 0",
